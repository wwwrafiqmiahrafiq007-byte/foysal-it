# FOYSAL IT OS environment template
# Never commit real secrets. Use your hosting provider's secret manager in production.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=

# Authentication
TOKEN_SECRET=

# AI provider configuration
AI_PROVIDER_NAME=openai
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_KEY=
AI_OPENAI_MODE=chat
AI_MODEL=
AI_BASE_URL=
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_KEY=
AI_GROQ_MODEL=
XAI_MODEL=
OPENROUTER_MODELS=

# Speech / voice providers
AI_SPEECH_KEY=
AI_TTS_KEY=

# Google / Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional public integrations
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
